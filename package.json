{
  "name": "qcm-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/media.cjs && node scripts/fonts.cjs && node scripts/og.cjs && node scripts/feed.cjs && node scripts/sponsors.cjs",
    "build": "vite build && node scripts/sitemap.cjs && node scripts/prerender.cjs && node scripts/prerender-dom.cjs && node scripts/preloads.cjs && node scripts/check-prerender.cjs",
    "build:spa": "vite build",
    "build:static": "vite build && node scripts/prerender.cjs",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "lhci": "lhci autorun --config=lighthouserc.json"
  },
  "dependencies": {
    "@gsap/react": "^2.1.1",
    "@reduxjs/toolkit": "^2.2.5",
    "@vercel/analytics": "^1.3.1",
    "appwrite": "^15.0.0",
    "axios": "^1.7.4",
    "gsap": "^3.12.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.51.5",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.5.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.18.4",
    "react-slick": "^0.30.2",
    "slick-carousel": "^1.8.1",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@prerenderer/renderer-jsdom": "^1.1.9",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "fontkit": "^2.0.4",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "puppeteer-core": "^25.12.0",
    "satori": "^0.36.0",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^3.4.3",
    "vite": "^8.3.2",
    "vite-plugin-image-optimizer": "^2.0.3"
  }
