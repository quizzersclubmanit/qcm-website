{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/team",
        "http://localhost:4173/faqs",
        "http://localhost:4173/signup",
        "http://localhost:4173/events/iqc"
      ],
      "startServerCommand": "node scripts/serve-dist.cjs 4173",
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 3500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 400000 }],
        "resource-summary:image:size": ["warn", { "maxNumericValue": 1000000 }]
      }
    }
  }
}
